# Copy to .env and fill in. Every variable is optional; unset ones use the defaults
# below. A variable that is set must be valid (non-empty), or the app refuses to start.

# SQLAlchemy database URL.
# DATABASE_URL=sqlite:///./app.db

# Needed only for POST /chat to call the model.
# OPENAI_API_KEY=sk-...

# DEBUG, INFO, WARNING, ERROR or CRITICAL.
# LOG_LEVEL=INFO

# Set to 1 or true to log JSON lines instead of text.
# LOG_JSON=false
