{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && uv run --quiet python .agents/ruff_after_edit.py; exit 0",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
